{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "schema_version",
    "program_id",
    "gitson",
    "gst",
    "qson",
    "entry_gate",
    "execution_mode",
    "compatibility"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "program_id": { "type": "string" },

    "gitson": { "type": "string" },
    "gst": { "type": "string" },
    "qson": { "type": "string" },

    "entry_gate": { "type": "string" },

    "execution_mode": {
      "type": "string",
      "enum": ["deterministic"]
    },

    "compatibility": {
      "type": "object",
      "required": ["gitson", "gst", "qson"],
      "properties": {
        "gitson": { "type": "string" },
        "gst": { "type": "string" },
        "qson": { "type": "string" }
      }
    }
  }
}
