{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "G8SON Gate Definition",
  "type": "object",
  "required": ["gate_id", "gate_name", "gate_type", "conditions"],
  "additionalProperties": false,
  "properties": {
    "gate_id": { "type": "string" },
    "gate_name": { "type": "string" },
    "gate_type": {
      "type": "string",
      "enum": ["AND", "OR", "NAND", "NOR", "BOOLEAN", "tote_test", "tote_operate", "transform", "condition"]
    },
    "prompt_template": { "type": "string" },
    "modality": { "type": "string" },
    "adsr": {
      "type": "object",
      "properties": {
        "attack": { "type": "number" },
        "decay": { "type": "number" },
        "sustain": { "type": "number" },
        "release": { "type": "number" },
        "pan": { "type": "number" }
      }
    },
    "expects": { "type": "array", "items": { "type": "string" } },
    "produces": { "type": "array", "items": { "type": "string" } },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["left", "operator", "right"],
        "properties": {
          "left": {},
          "operator": { "type": "string", "enum": ["=", "!=", ">", "<", ">=", "<=", "contains"] },
          "right": {}
        }
      }
    },
    "routing": {
      "type": "object",
      "properties": {
        "on_true": { "type": "string", "description": "gate_id to go to if conditions pass" },
        "on_false": { "type": "string", "description": "gate_id to go to if conditions fail" }
      }
    },
    "atomic_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["req_id", "requirement"],
        "properties": {
          "req_id": { "type": "string" },
          "requirement": { "type": "string" },
          "threshold": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "failure_policy": {
      "type": "object",
      "properties": {
        "on_reject": { "type": "string", "enum": ["halt", "continue", "human_verify"] },
        "on_ambiguity": { "type": "string", "enum": ["halt", "continue", "human_verify"] }
      }
    }
  }
}
