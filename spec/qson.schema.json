{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schema_version", "run_id", "trace"],
  "properties": {
    "schema_version": { "type": "string" },
    "run_id": { "type": "string" },

    "trace": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "gate_id",
          "step_id",
          "type",
          "result",
          "timestamp"
        ],
        "properties": {
          "gate_id": { "type": "string" },
          "step_id": { "type": "string" },
          "type": { "type": "string" },

          "input": {},
          "output": {},

          "result": {
            "type": "string",
            "enum": ["pass", "fail", "continue"]
          },

          "timestamp": { "type": "string" },

          "confidence": { "type": "number" },
          "ambiguity": { "type": "number" }
        }
      }
    }
  }
}
