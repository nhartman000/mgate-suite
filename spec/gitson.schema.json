{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schema_version", "bundle_id", "gates"],
  "properties": {
    "schema_version": { "type": "string" },
    "bundle_id": { "type": "string" },

    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gate_id", "execution", "steps"],
        "properties": {
          "gate_id": { "type": "string" },

          "execution": {
            "type": "object",
            "required": ["max_iterations"],
            "properties": {
              "max_iterations": { "type": "integer", "minimum": 1 }
            }
          },

          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["step_id", "type"],
              "properties": {
                "step_id": { "type": "string" },

                "type": {
                  "type": "string",
                  "enum": ["test", "operate", "route"]
                },

                "condition": { "type": "string" },
                "prompt": { "type": "string" },
                "next": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
