{
  "gates": [
    {
      "gate_id": "G1",
      "gate_name": "CheckValueEquals1",
      "gate_type": "BOOLEAN",
      "prompt_template": "Verify input value.",
      "expects": ["event_candidate","confidence","ambiguity"],
      "produces": ["decision","status","trace_id"],
      "conditions": [{"left": 1, "operator": "=", "right": 1}],
      "routing": {
        "on_true": "G2",
        "on_false": "G3"
      },
      "atomic_requirements": [{"req_id":"R1","requirement":"be boolean"}]
    },
    {
      "gate_id": "G2",
      "gate_name": "AllConditionsMet",
      "gate_type": "AND",
      "prompt_template": "AND gate passed.",
      "expects": ["event_candidate","confidence","ambiguity"],
      "produces": ["decision","status","trace_id"],
      "conditions": [
        {"left": true, "operator": "=", "right": true},
        {"left": 42, "operator": ">", "right": 0}
      ],
      "atomic_requirements": [{"req_id":"R2","requirement":"all conditions met"}]
    },
    {
      "gate_id": "G3",
      "gate_name": "FailCondition",
      "gate_type": "NOR",
      "prompt_template": "NOR gate executed.",
      "expects": ["event_candidate","confidence","ambiguity"],
      "produces": ["decision","status","trace_id"],
      "conditions": [
        {"left": false, "operator": "=", "right": true},
        {"left": 0, "operator": ">", "right": 1}
      ],
      "atomic_requirements": [{"req_id":"R3","requirement":"negative path"}]
    }
  ],
  "graph": {
    "nodes": ["G1", "G2", "G3"],
    "edges": [
      {"from": "G1", "to": "G2"},
      {"from": "G1", "to": "G3"}
    ]
  }
}
